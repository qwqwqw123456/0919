# =============================================================================
# DeepSeek V4 Base Image Dockerfile
# =============================================================================
# 基础镜像：包含 CUDA 运行时、Python 环境及核心依赖
# 用于构建所有服务的底层镜像

# -----------------------------------------------------------------------------
# 第一阶段：构建阶段
# -----------------------------------------------------------------------------
# 使用 NVIDIA CUDA 12.1 运行时镜像作为基础
# - runtime: 仅包含 CUDA 运行时，不含开发工具
# - ubuntu22.04: 稳定的长期支持版本
FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04 AS builder

# 设置环境变量避免交互式提示
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# 安装构建工具和基础依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Python 环境
    python3.10 \
    python3-pip \
    python3.10-dev \
    python3.10-venv \
    # 系统工具
    git \
    curl \
    wget \
    vim \
    htop \
    net-tools \
    iputils-ping \
    # 压缩工具
    unzip \
    gzip \
    tar \
    bzip2 \
    # 文本处理
    nano \
    less \
    jq \
    # 网络工具
    ca-certificates \
    openssl \
    # 其他依赖
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    # 清理缓存
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# -----------------------------------------------------------------------------
# 第二阶段：运行时镜像
# -----------------------------------------------------------------------------
FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04

# 设置构建参数
ARG BUILDER_UID=1000
ARG BUILDER_GID=1000
ARG BUILDER_USER=deepseek

# 环境变量配置
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # CUDA 相关
    CUDA_HOME=/usr/local/cuda \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH \
    PATH=/usr/local/cuda/bin:$PATH \
    # 工作目录
    APP_HOME=/app

# 复制系统依赖和 Python 环境
COPY --from=builder /usr/bin/python3* /usr/bin/
COPY --from=builder /usr/lib/python3* /usr/lib/
COPY --from=builder /usr/local/bin/pip* /usr/local/bin/
COPY --from=builder /usr/local/lib/python3* /usr/local/lib/

# 安装 Ubuntu 系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Python 运行时依赖
    python3-pip \
    # 图形处理库 (OpenCV 等需要)
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    # 网络通信
    ca-certificates \
    openssl \
    curl \
    # 进程管理
    supervisor \
    # 日志轮转
    logrotate \
    # 时区数据
    tzdata \
    # 清理
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 创建非 root 用户（安全最佳实践）
RUN groupadd --gid ${BUILDER_GID} ${BUILDER_USER} \
    && useradd --uid ${BUILDER_UID} --gid ${BUILDER_GID} \
               --shell /bin/bash --create-home ${BUILDER_USER}

# 创建应用目录结构
RUN mkdir -p ${APP_HOME} \
    && mkdir -p ${APP_HOME}/logs \
    && mkdir -p ${APP_HOME}/data \
    && mkdir -p ${APP_HOME}/models \
    && mkdir -p ${APP_HOME}/cache \
    && chown -R ${BUILDER_USER}:${BUILDER_USER} ${APP_HOME}

# 安装 Python 核心依赖（预装以加速后续构建）
RUN python3 -m pip install --no-cache-dir \
    pip==23.3.1 \
    setuptools==69.0.3 \
    wheel==0.42.0

# 切换到非 root 用户
USER ${BUILDER_USER}
WORKDIR ${APP_HOME}

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python3 -c "import sys; sys.exit(0)" || exit 1

# 默认命令
CMD ["/bin/bash"]
